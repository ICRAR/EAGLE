{
    "$schema": "http://json-schema.org/schema#",
    "$defs": {
        "scalarValue": {
            "type": [
                "string",
                "boolean",
                "number",
                "null"
            ]
        },
        "eagleId": {
            "type": [
                "string",
                "null"
            ],
            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
        },
        "fileLocation": {
            "type": "object",
            "properties": {
                "repositoryService": {
                    "type": "string"
                },
                "repositoryBranch": {
                    "type": "string"
                },
                "repositoryName": {
                    "type": "string"
                },
                "repositoryPath": {
                    "type": "string"
                },
                "repositoryFileName": {
                    "type": "string"
                },
                "commitHash": {
                    "type": "string"
                },
                "downloadUrl": {
                    "type": "string"
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "graphConfigNode": {
            "type": "object",
            "properties": {
                "fields": {
                    "type": "object",
                    "patternProperties": {
                        "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}": {
                            "$ref": "#/$defs/graphConfigField"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "graphConfigField": {
            "type": "object",
            "properties": {
                "value": {
                    "$ref": "#/$defs/scalarValue"
                },
                "comment": {
                    "type": "string",
                    "default": ""
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "field": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "default": ""
                },
                "value": {
                    "$ref": "#/$defs/scalarValue"
                },
                "defaultValue": {
                    "$ref": "#/$defs/scalarValue"
                },
                "description": {
                    "type": "string",
                    "default": ""
                },
                "readonly": {
                    "type": "boolean",
                    "default": false
                },
                "type": {
                    "type": "string"
                },
                "precious": {
                    "type": "boolean",
                    "default": false
                },
                "options": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/scalarValue"
                    },
                    "default": []
                },
                "positional": {
                    "type": "boolean",
                    "default": false
                },
                "encoding": {
                    "type": "string",
                    "enum": [
                        "dill",
                        "pickle",
                        "npy",
                        "path",
                        "utf-8",
                        "eval",
                        "dataurl",
                        "binary",
                        "raw"
                    ],
                    "default": "dill"
                },
                "id": {
                    "$ref": "#/$defs/eagleId"
                },
                "parameterType": {
                    "type": "string",
                    "enum": [
                        "Application",
                        "Component",
                        "Constraint",
                        "Construct",
                        "Unknown"
                    ],
                    "default": "Component"
                },
                "usage": {
                    "type": "string",
                    "enum": [
                        "NoPort",
                        "InputPort",
                        "OutputPort",
                        "InputOutput"
                    ],
                    "default": "NoPort"
                },
                "changeable": {
                    "type": "boolean",
                    "default": true
                },
                "edgeIds": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/eagleId"
                    },
                    "default": []
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "node": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string",
                    "default": ""
                },
                "categoryType": {
                    "type": "string",
                    "default": ""
                },
                "commitHash": {
                    "type": "string",
                    "default": ""
                },
                "dataHash": {
                    "type": "string",
                    "default": ""
                },
                "embedId": {
                    "$ref": "#/$defs/eagleId"
                },
                "id": {
                    "$ref": "#/$defs/eagleId"
                },
                "name": {
                    "type": "string",
                    "default": ""
                },
                "description": {
                    "type": "string",
                    "default": ""
                },
                "x": {
                    "type": "number",
                    "default": 0
                },
                "y": {
                    "type": "number",
                    "default": 0
                },
                "comment": {
                    "type": "string",
                    "default": ""
                },
                "paletteDownloadUrl": {
                    "type": "string",
                    "default": ""
                },
                "repositoryUrl": {
                    "type": "string",
                    "default": ""
                },
                "fields": {
                    "type": "object",
                    "patternProperties": {
                        "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}": {
                            "$ref": "#/$defs/field"
                        }
                    },
                    "additionalProperties": false,
                    "default": {}
                },
                "parentId": {
                    "$ref": "#/$defs/eagleId"
                },
                "inputApplicationId": {
                    "$ref": "#/$defs/eagleId"
                },
                "outputApplicationId": {
                    "$ref": "#/$defs/eagleId"
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "edge": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/eagleId"
                },
                "closesLoop": {
                    "type": "boolean",
                    "default": false
                },
                "srcNodeId": {
                    "$ref": "#/$defs/eagleId"
                },
                "srcPortId": {
                    "$ref": "#/$defs/eagleId"
                },
                "destNodeId": {
                    "$ref": "#/$defs/eagleId"
                },
                "destPortId": {
                    "$ref": "#/$defs/eagleId"
                },
                "loopAware": {
                    "type": "boolean",
                    "default": false
                },
                "comment": {
                    "type": "string",
                    "default": ""
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "visual": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/eagleId"
                },
                "x": {
                    "type": "number",
                    "default": 0
                },
                "y": {
                    "type": "number",
                    "default": 0
                },
                "width": {
                    "type": "number",
                    "default": 0
                },
                "height": {
                    "type": "number",
                    "default": 0
                },
                "type": {
                    "type": "string",
                    "default": "Text"
                },
                "content": {
                    "type": "string",
                    "default": ""
                },
                "color": {
                    "type": "string",
                    "default": ""
                },
                "targetId": {
                    "$ref": "#/$defs/eagleId"
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "graphConfig": {
            "type": "object",
            "properties": {
                "id": {
                    "$ref": "#/$defs/eagleId"
                },
                "modelData": {
                    "$ref": "#/$defs/modelData"
                },
                "nodes": {
                    "type": "object",
                    "patternProperties": {
                        "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}": {
                            "$ref": "#/$defs/graphConfigNode"
                        }
                    },
                    "additionalProperties": false
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "modelData": {
            "type": "object",
            "properties": {
                "readonly": {
                    "type": "boolean",
                    "default": false
                },
                "name": {
                    "type": "string",
                    "default": ""
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "Graph",
                        "GraphConfig",
                        "Palette",
                        "JSON",
                        "Markdown",
                        "Unknown"
                    ],
                    "default": "Graph"
                },
                "generatorVersion": {
                    "type": "string",
                    "default": ""
                },
                "generatorCommitHash": {
                    "type": "string",
                    "default": ""
                },
                "generatorName": {
                    "type": "string",
                    "default": ""
                },
                "schemaVersion": {
                    "type": "string",
                    "default": ""
                },
                "lastModifiedName": {
                    "type": "string",
                    "default": ""
                },
                "lastModifiedEmail": {
                    "type": "string",
                    "default": ""
                },
                "lastModifiedDatetime": {
                    "type": "number",
                    "default": 0
                },
                "repositoryUrl": {
                    "type": "string",
                    "default": ""
                },
                "signature": {
                    "type": "string",
                    "default": ""
                },
                "shortDescription": {
                    "type": "string",
                    "default": ""
                },
                "detailedDescription": {
                    "type": "string",
                    "default": ""
                },
                "location": {
                    "$ref": "#/$defs/fileLocation"
                },
                "graphLocation": {
                    "$ref": "#/$defs/fileLocation"
                },
                "numLGNodes": {
                    "type": "number",
                    "default": 0
                }
            },
            "required": [],
            "additionalProperties": false
        }
    },
    "type": "object",
    "properties": {
        "modelData": {
            "$ref": "#/$defs/modelData"
        },
        "nodes": {
            "type": "object",
            "patternProperties": {
                "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}": {
                    "$ref": "#/$defs/node"
                }
            },
            "additionalProperties": false
        },
        "edges": {
            "type": "object",
            "patternProperties": {
                "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}": {
                    "$ref": "#/$defs/edge"
                }
            },
            "additionalProperties": false
        },
        "visuals": {
            "type": "object",
            "patternProperties": {
                "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}": {
                    "$ref": "#/$defs/visual"
                }
            },
            "additionalProperties": false
        },
        "graphConfigurations": {
            "type": "object",
            "patternProperties": {
                "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}": {
                    "$ref": "#/$defs/graphConfig"
                }
            },
            "additionalProperties": false
        },
        "activeGraphConfigId": {
            "$ref": "#/$defs/eagleId"
        }
    },
    "required": [
        "modelData",
        "nodes"
    ],
    "additionalProperties": false
}
